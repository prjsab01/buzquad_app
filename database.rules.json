{
  "rules": {
    // ── call rooms (WebRTC signaling) ────────────────────────────────────────
    "call_rooms": {
      "$roomId": {
        // Room doc: only caller or callee can read/write
        ".read": "auth != null && (data.child('callerUid').val() === auth.uid || data.child('calleeUid').val() === auth.uid)",
        ".write": "auth != null",

        "offer": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('call_rooms').child($roomId).child('callerUid').val() === auth.uid)"
        },
        "answer": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('call_rooms').child($roomId).child('calleeUid').val() === auth.uid)"
        },
        "callerCandidates": {
          "$candidateId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "calleeCandidates": {
          "$candidateId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },

    // ── presence ─────────────────────────────────────────────────────────────
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])"
      }
    },

    // ── typing indicators ─────────────────────────────────────────────────────
    "typing": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    // ── deny everything else ──────────────────────────────────────────────────
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
