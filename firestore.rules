rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── usernames (uniqueness index) ──────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']);
      allow delete: if isOwner(resource.data.authorUid);
    }

    // ── communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          || resource.data.ownerUid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.ownerUid);

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // ── events ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpCount'])
          || resource.data.hostUid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.hostUid);
    }

    // ── polls ─────────────────────────────────────────────────────────────────
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['options', 'totalVotes'])
          || resource.data.authorUid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.authorUid);
    }

    // ── conversations ─────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    // ── activity items (admin-curated content) ────────────────────────────────
    match /activity_items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn(); // enforced by VITE_ADMIN_EMAILS client-side; tighten with custom claims later
      allow update: if isSignedIn() && resource.data.addedByUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.addedByUid == request.auth.uid;
    }

    // ── activity sessions ─────────────────────────────────────────────────────
    match /activity_sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          // host can end session or update anything
          resource.data.hostUid == request.auth.uid
          // participants can join (add their uid + increment count)
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['participantUids', 'participantCount'])
        );
      allow delete: if false;
    }

    // ── admin audit logs ──────────────────────────────────────────────────────
    match /admin_audit_logs/{logId} {
      allow read, write: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
