# Firebase configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Realtime Database URL (required for calls, presence, typing)
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Comma-separated admin emails (client-side guard — replace with custom claims in production)
VITE_ADMIN_EMAILS=you@example.com

# Cloudinary media uploads
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Google OAuth client ID (optional — only needed for Google Drive backup)
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Android APK download URL (set after building APK and hosting it)
# e.g. GitHub Releases URL or Cloudinary URL
VITE_APK_DOWNLOAD_URL=https://github.com/prjsab01/buzquad_app/releases/download/v1.0.0/app-release-signed.apk

# Admin claims Worker URL (set after deploying workers/admin-claims/)
VITE_CLAIMS_WORKER_URL=https://buzquad-admin-claims.your-subdomain.workers.dev

# OG preview Worker URL (set after deploying workers/og-preview/)
# Enables link previews when pasting URLs into posts
VITE_OG_WORKER_URL=https://buzquad-og-preview.your-subdomain.workers.dev

# Pexels API key (free tier — for Reels short video discovery)
# Get one at https://www.pexels.com/api/
VITE_PEXELS_API_KEY=your-pexels-api-key
