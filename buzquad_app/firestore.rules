rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      // Private circle: `users/{uid}/friends/{friendUid}` is a mutual edge.
      // Either side of the friendship may create/delete the edge (write happens
      // in a batch from acceptFriendRequest or removeFriend).
      match /friends/{friendUid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow create, delete: if isSignedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow update: if false;
      }

      // Per-user call history. Only the owner can read or write.
      match /call_logs/{logId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.fromUid == request.auth.uid;
      allow update: if false;
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'reactions']);
      allow delete: if isOwner(resource.data.authorUid);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          || resource.data.ownerUid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.ownerUid);

      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']);
        allow delete: if isSignedIn()
          && resource.data.authorUid == request.auth.uid;
      }

      match /held_posts/{heldId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn();
        allow delete: if false;
      }

      match /held_posts/{heldId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'];
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'moderator'];
        allow delete: if false;
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpCount'])
          || resource.data.hostUid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.hostUid);
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['options', 'totalVotes'])
          || resource.data.authorUid == request.auth.uid
        );
      allow delete: if isOwner(resource.data.authorUid);
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow update, delete: if false;
      }
    }

    match /activity_items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.addedByUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.addedByUid == request.auth.uid;
    }

    match /activity_sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          resource.data.hostUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['participantUids', 'participantCount'])
        );
      allow delete: if false;
    }

    match /notifications/{uid}/items/{notifId} {
      allow read: if isOwner(uid);
      allow create: if isSignedIn();
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /backup_settings/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /notes/{noteId} {
      allow read: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.scope == 'shared');
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.scope == 'shared');
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /admin_audit_logs/{logId} {
      allow read: if isSignedIn() && request.auth.token.admin == true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // §45 Kudos
    match /kudos/{kudosId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // §45 Community awards
    match /community_awards/{awardId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // §57 Watchlists
    match /watchlists/{listId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }

    // §56 Event check-ins
    match /event_checkins/{checkinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
